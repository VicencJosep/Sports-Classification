# Copia a backend/.env y ajusta. Prefijo BACKEND_. Todas son opcionales.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# BACKEND_STORAGE_DIR=/app/backend/storage
# BACKEND_PIPELINE_PYTHON=/opt/venv/bin/python
# BACKEND_RENDER_VIDEO=false
# BACKEND_SKIP_HOMOGRAPHY=false
# Equipos por apariencia (PRTReID) requiere el paquete `prtreid` en /opt/venv; si falta, true.
# BACKEND_SKIP_CLASSIFICATION=false
# BACKEND_MAX_UPLOAD_BYTES=8589934592
