__pycache__/
.claude/
clips_analisis/
dataset_vjepa_backup/
dataset_ball_actions/
datasets/
temp/
models/
.env
output/

# Perfil persistente de Chromium usado por automation/molmo_publisher.py:
# contiene las COOKIES DE SESIÓN de Google. Nunca se versiona.
automation/chrome_session/

basketball/inputs
basketball/outputs
basketball/models

# ground_truth/: los JSON de verdad (*.gt.json, highlights_goals.json) van a git; vídeos y cachés no.
ground_truth/*
!ground_truth/*.gt.json
!ground_truth/highlights_goals.json

# PnLCalib: repo de terceros clonado tal cual (calibración de campo). A
# diferencia de Soccer_Master no hemos modificado nada dentro, así que se
# ignora entero. Vive dentro de models/ (ya ignorado arriba) — se recupera con:
#   git clone https://github.com/mguti97/PnLCalib.git models/homography/PnLCalib
models/homography/

# ------------------------------------------------------------------ #
# Soccer_Master: repo de terceros vendorizado. Se ignora todo salvo los
# ficheros que hemos modificado/añadido nosotros (ver README § "Cambios
# sobre el repositorio original Soccer_Master" para el detalle de cada uno).
#
# OJO con la sintaxis: "Soccer_Master/" (con barra, sin *) ignoraría el
# directorio entero y las excepciones de abajo NO harían nada — git no
# desciende a mirar dentro de un directorio ya ignorado. Por eso se usa
# "carpeta/*" + "!carpeta/subcarpeta/" en cascada, un nivel cada vez, hasta
# llegar a cada fichero concreto.
# ------------------------------------------------------------------ #
Soccer_Master/*
!Soccer_Master/SoccerMaster/

Soccer_Master/SoccerMaster/*
!Soccer_Master/SoccerMaster/infer_mp4.py
!Soccer_Master/SoccerMaster/eval_captions.py
!Soccer_Master/SoccerMaster/eval_classification_head.py
!Soccer_Master/SoccerMaster/models/

Soccer_Master/SoccerMaster/models/*
!Soccer_Master/SoccerMaster/models/soccer_master.py
!Soccer_Master/SoccerMaster/models/deformable_detr/

Soccer_Master/SoccerMaster/models/deformable_detr/*
!Soccer_Master/SoccerMaster/models/deformable_detr/ops/

Soccer_Master/SoccerMaster/models/deformable_detr/ops/*
!Soccer_Master/SoccerMaster/models/deformable_detr/ops/functions/
!Soccer_Master/SoccerMaster/models/deformable_detr/ops/modules/

Soccer_Master/SoccerMaster/models/deformable_detr/ops/functions/*
!Soccer_Master/SoccerMaster/models/deformable_detr/ops/functions/ms_deform_attn_func.py

Soccer_Master/SoccerMaster/models/deformable_detr/ops/modules/*
!Soccer_Master/SoccerMaster/models/deformable_detr/ops/modules/ms_deform_attn.py

yolo11x.pt
# Pesos base que Ultralytics descarga en la raíz al entrenar (yolo11s, yolo26n...)
/yolo*.pt
# Backend FastAPI (backend/): entorno propio, datos subidos y salidas de análisis
backend/.venv/
backend/storage/
.pytest_cache/
